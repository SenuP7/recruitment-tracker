# Environment shape and the things that quietly cost money.
#
# Kept separate from django.config because these are decisions about the
# deployment, not about the application.

option_settings:
  aws:elasticbeanstalk:environment:
    # No load balancer. An ALB is roughly $16-22 a month on its own, which
    # is more than everything else here combined, and one instance serves
    # this comfortably. Changing to LoadBalanced later is a rebuild, not an
    # edit, so decide deliberately.
    EnvironmentType: SingleInstance

  aws:ec2:instances:
    InstanceTypes: t3.micro

  aws:elasticbeanstalk:cloudwatch:logs:
    # Worth having: without it the only way to read a traceback is to SSH in.
    StreamLogs: true
    DeleteOnTerminate: false
    # Log groups keep data forever by default, and that bill grows quietly
    # long after the free ingestion allowance is used up.
    RetentionInDays: 7

commands:
  01_swap_file:
    # t3.micro has 1 GB of RAM, and installing this requirement set peaks
    # above it. The deploy then fails with a bare "Killed", which reads like
    # a platform fault rather than memory exhaustion. One gigabyte of swap
    # costs nothing and makes the failure go away.
    test: "[ ! -f /swapfile ]"
    command: |
      fallocate -l 1G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=1024
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
