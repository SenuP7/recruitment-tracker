# Runs the three housekeeping commands on a schedule.
#
# Elastic Beanstalk's own cron.yaml periodic tasks exist only on *worker*
# environments, where the cron daemon POSTs to an HTTP endpoint instead of
# running a command. This is a web environment (see django.config), so the
# schedule is an ordinary crontab installed on the instance.
#
# Everything here is rewritten on every deploy, so edit this file rather than
# anything under /etc on a running instance.

packages:
  yum:
    cronie: []

files:
  "/etc/cron.d/candidflow-housekeeping":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Installed by .ebextensions/cron.config. Times are UTC.
      SHELL=/bin/bash
      PATH=/usr/local/bin:/usr/bin:/bin
      MAILTO=""

      # Pending delegation offers within 48 hours of the interview revert to
      # the assigned interviewer. Hourly: "48 hours before" is a moving
      # target, and a missed day means nobody turns up to the round.
      10 * * * * root /usr/bin/flock -n /var/run/candidflow-delegations.lock /var/app/current/scripts/housekeeping/expire_delegations.sh

      # Unconfirmed public applications and their CVs, after 30 days, because
      # the privacy notice promises that deletion.
      15 3 * * 0 root /usr/bin/flock -n /var/run/candidflow-pending.lock /var/app/current/scripts/housekeeping/purge_pending_applications.sh

      # Audit entries past the 730-day retention.
      45 3 * * 0 root /usr/bin/flock -n /var/run/candidflow-audit.lock /var/app/current/scripts/housekeeping/purge_audit_events.sh

  "/etc/logrotate.d/candidflow-housekeeping":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/candidflow-housekeeping.log {
          weekly
          rotate 8
          missingok
          notifempty
          compress
          copytruncate
      }

container_commands:
  01_snapshot_environment:
    # cron sees none of the environment properties, and the deployment's env
    # file is only there while the deploy is running. Keep a copy the jobs
    # can read. Root-only: it holds the database password.
    command: "if [ -f /opt/elasticbeanstalk/deployment/env ]; then install -m 600 -o root -g root /opt/elasticbeanstalk/deployment/env /opt/elasticbeanstalk/deployment/candidflow_env; fi"
  02_executable_scripts:
    # The repository is edited on Windows, which does not carry the
    # executable bit through git reliably.
    command: "chmod +x scripts/housekeeping/*.sh"
  03_enable_cron:
    # crond picks up /etc/cron.d without a restart, so this only has to
    # make sure the daemon is running at all. Deliberately not a `services:
    # sysvinit:` block -- on Amazon Linux 2023 everything is systemd, and a
    # service block that cannot resolve would fail the whole deployment
    # over something this app can survive without.
    command: "systemctl enable --now crond 2>/dev/null || true"
