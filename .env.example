# Copy this file to .env and fill in real values. .env is gitignored.

SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1

# Leave DATABASE_URL empty to use local SQLite. Its value is never parsed as a URL --
# presence alone selects the Postgres branch below; DB_* supplies the real connection info.
DATABASE_URL=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# S3 (CV storage) -- defaults exist in settings.py, override only if using a different bucket/region.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# notification-service (see notification-service/README.md). Leave NOTIFICATIONS_SQS_QUEUE_URL
# empty to run without notifications -- publish_event() will no-op safely.
NOTIFICATIONS_SQS_QUEUE_URL=
NOTIFICATIONS_AWS_REGION=

# Set to True to try the notification pipeline locally with no AWS account at all --
# renders emails in-process and writes them to local_notifications/ instead of SQS/SES.
# See notification_client/local_runner.py.
NOTIFICATIONS_LOCAL_MODE=False

# Only needed locally if you want to exercise the real SQS publish path from a dev machine
# without an existing AWS CLI profile. Use a personal IAM user scoped to sqs:SendMessage only
# (see notification-service/template.yaml's RecruitmentTrackerNotificationPublish policy) --
# never reuse broader credentials here. Leave unset to rely on boto3's default credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Production only -------------------------------------------------------
# Required when DJANGO_DEBUG is not True. The app refuses to start without
# them rather than falling back to a key that is published in this repo.
#
#   SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(64))"
#   DJANGO_ALLOWED_HOSTS: set it above to your domain, plus whatever host the
#   load balancer health check uses. Do not add a second line for it here --
#   dotenv keeps the last value it sees, and an empty one rejects every
#   request.
# Needed for form submissions behind TLS termination. Include the scheme,
# comma-separated: https://candidflow.example,https://www.candidflow.example
DJANGO_CSRF_TRUSTED_ORIGINS=

# CloudFront terminates TLS and sends this as an origin custom header. The
# origin refuses any request without it, which is what stops the
# elasticbeanstalk.com hostname serving the whole site over plain HTTP.
# Leave empty locally -- empty means the check is off.
#   Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDFRONT_ORIGIN_SECRET=

# HTTPS handling. Defaults to on whenever DEBUG is off, so normally leave
# these alone. HSTS starts at one hour; raise it to 2592000 (30 days) once
# HTTPS has been stable for a while.
DJANGO_HTTPS=
DJANGO_HSTS_SECONDS=
DJANGO_HSTS_SUBDOMAINS=False

# Moves the Django admin off /admin/, which is scanned constantly. Use
# something unguessable; it is not a substitute for a strong password.
DJANGO_ADMIN_PATH=

# Published on the privacy, security, help and candidate pages, and in
# /.well-known/security.txt. Leave unset to keep the @candidflow.example
# placeholders, which bounce.
CANDIDFLOW_HELP_EMAIL=
CANDIDFLOW_PRIVACY_EMAIL=
CANDIDFLOW_SECURITY_EMAIL=

# Shown in candidate emails.
CANDIDFLOW_COMPANY_NAME=Candidflow

# Shown in the public site footer and on the status page.
CANDIDFLOW_VERSION=1.0.0

# Root log level. INFO in production; DEBUG is very noisy and can put request
# data in CloudWatch, so leave it alone unless you are chasing something.
DJANGO_LOG_LEVEL=INFO

# Optional: fixes the password seed_demo uses instead of generating one.
CANDIDFLOW_DEMO_PASSWORD=
